# Required. Reown (WalletConnect) project ID from https://dashboard.reown.com
# In the Reown project, add https://stratafin.org (and your Vercel preview domain) to the allowed domains.
VITE_REOWN_PROJECT_ID=

# Recommended. Solana mainnet RPC used by the dashboard (balances, creator fees, coin lookup, transactions).
# Use a provider that supports getProgramAccounts (e.g. Helius) so coins are found instantly.
# This value ships to the browser: restrict the key to stratafin.org in your RPC provider's dashboard.
# If empty, Reown's RPC for the project above is used.
VITE_SOLANA_RPC_URL=
